<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleDisplayName</key>
	<string>GabaritScan</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>GabaritScan</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Permissions obligatoires -->
	<key>NSCameraUsageDescription</key>
	<string>GabaritScan utilise la caméra pour détecter le tag AprilTag et photographier le gabarit.</string>
	<key>NSMotionUsageDescription</key>
	<string>GabaritScan utilise le gyroscope et l'accéléromètre pour le suivi ARKit.</string>

	<!-- ARKit -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arkit</string>
		<string>arm64</string>
	</array>

	<!-- Minimum iOS 16 -->
	<key>MinimumOSVersion</key>
	<string>16.0</string>
</dict>
</plist>
